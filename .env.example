# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API (Data API URL and the anon / publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site origin without trailing slash: used in invite links and OAuth redirects.
# Local: http://localhost:3000 · Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Supabase → Project Settings → API → service_role (secret). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Long random string; Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=generate-a-long-random-string
